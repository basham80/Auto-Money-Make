# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# SOLANA MAINNET PRODUCTION CONFIGURATION
# Production cluster: mainnet-beta (Default in production)
SOLANA_CLUSTER="mainnet-beta"

# Main Treasury Wallet (Destination for all revenue, sweeps, and profit)
MAIN_TREASURY_WALLET="HTN1fvHwbzKiMwh9YXZEe3eooiMdoCAs3TweWdiSZV5i"

# Dedicated Private / Primary Solana Mainnet RPC Endpoints & API Secrets
# Configure your private RPC provider keys below.
# The platform will prompt you to enter your values in the Settings/Secrets panel.
ALCHEMY_API_KEY=""
HELIUS_API_KEY=""

# Optional Custom RPC URLs (if full custom URL is preferred)
ALCHEMY_SOLANA_RPC_URL=""
HELIUS_SOLANA_RPC_URL=""

# Solana RPC Mesh Configuration
SOLANA_RPC_URL="https://rpc.ankr.com/solana"
SOLANA_WS_URL="wss://rpc.ankr.com/solana/ws"
PRIMARY_RPC="https://rpc.ankr.com/solana"
SECONDARY_RPC="https://api.mainnet.solana.com"
TERTIARY_RPC="https://solana-rpc.publicnode.com"

# Optional Server Signing Secret Key (Base58 encoded or seed hex)
# Isolated in server memory. Never exposed to browser, logs, or AI context.
SOLANA_SIGNING_PRIVATE_KEY=""
